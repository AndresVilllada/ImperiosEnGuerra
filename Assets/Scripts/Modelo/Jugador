using System;
using System.Linq;
using System.Collections.Generic;
using System.Collections.Concurrent;
using System.Threading;
using System.Threading.Tasks;
 
namespace ImperiosEnGuerra.Modelo
{
    // Evento simple que el Modelo deposita cuando algo relevante terminó en un
    // hilo secundario. El Controlador los va sacando de la cola (TryDequeue) y
    // decide qué mostrar en la Vista — el Modelo no sabe nada de la Vista.
    public class EventoJuego
    {
        public string Tipo { get; }
        public string Mensaje { get; }
 
        public EventoJuego(string tipo, string mensaje)
        {
            Tipo = tipo;
            Mensaje = mensaje;
        }
    }
 
    public class Jugador
    {
        public string Nombre { get; private set; }
        public Mapa Mapa { get; private set; }
        public ConcurrentDictionary<TipoRecurso, int> Recursos { get; private set; }
        public ConcurrentDictionary<Guid, Unidad> Unidades { get; private set; }
        public ConcurrentDictionary<Guid, Edificio> Edificios { get; private set; }
        public ConcurrentQueue<EventoJuego> Eventos { get; private set; }
 
        private readonly object candadoRecursos = new object();
 
        // Solo la usa JugarTurnoIA (más abajo) para elegir al azar qué
        // construir/entrenar/atacar cuando este Jugador lo maneja la máquina.
        private readonly Random random = new Random();
 
        public Jugador(string nombre, Mapa mapa)
        {
            Nombre = nombre;
            Mapa = mapa;
 
            Recursos = new ConcurrentDictionary<TipoRecurso, int>();
            Recursos[TipoRecurso.Oro] = 100;
            Recursos[TipoRecurso.Madera] = 100;
            Recursos[TipoRecurso.Piedra] = 100;
            Recursos[TipoRecurso.Metal] = 100;
 
            Unidades = new ConcurrentDictionary<Guid, Unidad>();
            Edificios = new ConcurrentDictionary<Guid, Edificio>();
            Eventos = new ConcurrentQueue<EventoJuego>();
        }
 
        public void AgregarRecurso(TipoRecurso tipo, int cantidad)
        {
            Recursos.AddOrUpdate(tipo, cantidad, (clave, valorActual) => valorActual + cantidad);
        }
 
        public bool TieneRecursosSuficientes(IReadOnlyDictionary<TipoRecurso, int> costo)
        {
            foreach (var par in costo)
            {
                if (!Recursos.ContainsKey(par.Key) || Recursos[par.Key] < par.Value)
                    return false;
            }
            return true;
        }
 
        public bool PagarCosto(IReadOnlyDictionary<TipoRecurso, int> costo)
        {
            lock (candadoRecursos)
            {
                if (!TieneRecursosSuficientes(costo)) return false;
 
                foreach (var par in costo)
                {
                    Recursos[par.Key] -= par.Value;
                }
                return true;
            }
        }
 
        public void AgregarUnidad(Unidad unidad) => Unidades[unidad.Id] = unidad;
        public void RemoverUnidad(Unidad unidad) => Unidades.TryRemove(unidad.Id, out _);
        public void AgregarEdificio(Edificio edificio) => Edificios[edificio.Id] = edificio;
 
        public bool CentroUrbanoDestruido()
        {
            foreach (var edificio in Edificios.Values)
            {
                if (edificio is TownCenter) return edificio.EstaDestruido;
            }
            return true;
        }
 
        public bool TodasLasUnidadesMilitaresDestruidas()
        {
            bool tuvoAlgunaTropa = false;
            foreach (var unidad in Unidades.Values)
            {
                if (unidad is Tropa)
                {
                    tuvoAlgunaTropa = true;
                    if (unidad.EstaViva) return false;
                }
            }
            return tuvoAlgunaTropa;
        }
 
        public void EntrenarLote(Taller taller, Func<Posicion, Tropa> fabricaTropa, Posicion posicionSpawn, int cantidad = 5)
        {
            if (taller == null || !taller.EstaConstruido)
            {
                Eventos.Enqueue(new EventoJuego("Entrenamiento", "El Taller no está listo para entrenar."));
                return;
            }
 
            for (int i = 0; i < cantidad; i++)
            {
                Task.Run(() =>
                {
                    var tropa = fabricaTropa(posicionSpawn);
 
                    if (!PagarCosto(tropa.Costo))
                    {
                        Eventos.Enqueue(new EventoJuego("Entrenamiento", $"No hay recursos suficientes para entrenar {tropa.Nombre}."));
                        return;
                    }
 
                    Thread.Sleep(3000);
 
                    AgregarUnidad(tropa);
                    Mapa.ColocarUnidad(posicionSpawn, tropa);
 
                    Eventos.Enqueue(new EventoJuego("Entrenamiento", $"{tropa.Nombre} entrenado y desplegado en {posicionSpawn}."));
                });
            }
        }
 
        public void ConstruirEdificio(Func<Posicion, Edificio> fabricaEdificio, Posicion posicion, int incrementoPorTick = 10, int intervaloMs = 500)
        {
            if (!Mapa.CeldaLibre(posicion))
            {
                Eventos.Enqueue(new EventoJuego("Construccion", "La celda de destino no está libre."));
                return;
            }
 
            Task.Run(() =>
            {
                var edificio = fabricaEdificio(posicion);
 
                if (!PagarCosto(edificio.Costo))
                {
                    Eventos.Enqueue(new EventoJuego("Construccion", $"No hay recursos suficientes para construir {edificio.Nombre}."));
                    return;
                }
 
                Mapa.ColocarEdificio(posicion, edificio);
                AgregarEdificio(edificio);
 
                Eventos.Enqueue(new EventoJuego("Construccion", $"Inició la construcción de {edificio.Nombre} en {posicion}."));
 
                while (!edificio.EstaConstruido)
                {
                    Thread.Sleep(intervaloMs);
                    edificio.AvanzarConstruccion(incrementoPorTick);
                    Eventos.Enqueue(new EventoJuego("Construccion", $"{edificio.Nombre} construcción {edificio.ProgresoConstruccion}%"));
                }
 
                Eventos.Enqueue(new EventoJuego("Construccion", $"{edificio.Nombre} completado en {posicion}."));
            });
        }
 
        public void IniciarRecoleccion(Villager aldeano, Recurso recurso, Posicion posicionRecurso, int intervaloMs = 1000)
        {
            if (aldeano == null || recurso == null) return;
 
            Task.Run(() =>
            {
                while (aldeano.EstaViva && !recurso.EstaAgotado())
                {
                    Thread.Sleep(intervaloMs);
 
                    int extraido = recurso.Extraer(aldeano.VelocidadRecoleccion);
                    if (extraido <= 0) break;
 
                    AgregarRecurso(recurso.Tipo, extraido);
 
                    Eventos.Enqueue(new EventoJuego(
                        "Recoleccion",
                        $"{aldeano.Nombre} recolectó {extraido} de {recurso.Tipo} (quedan {recurso.Cantidad})."
                    ));
                }
 
                if (recurso.EstaAgotado())
                {
                    Mapa.LiberarCelda(posicionRecurso);
                    Eventos.Enqueue(new EventoJuego("Recoleccion", $"El depósito de {recurso.Tipo} en {posicionRecurso} se agotó."));
                }
            });
        }
 
        // ------------------------------------------------------------------
        // IA: TODA la decisión vive aquí, en el Modelo — el Controlador
        // (Controlador/JugadorIA.cs) NO decide nada, solo llama este método
        // cada cierto tiempo en un bucle. Esta es la regla de "el Controlador
        // es el chismoso": recibe un aviso, se lo pasa al Modelo, y ya.
        //
        // Heurística simple a propósito (lo que se evalúa es la concurrencia,
        // no qué tan lista es la IA):
        //   1. ¿No tiene Taller construido?  -> construir uno
        //   2. ¿Tiene 150+ de Oro?           -> entrenar un lote de tropas (al azar)
        //   3. ¿Tiene alguna tropa viva?     -> atacar al rival con ella
        //   4. Si nada de eso aplica         -> construir una Casa
        // ------------------------------------------------------------------
        public void JugarTurnoIA(Jugador rival)
        {
            bool tieneTallerListo = Edificios.Values.Any(e => e is Taller && e.EstaConstruido);
 
            if (!tieneTallerListo)
            {
                ConstruirEdificio(pos => new Taller(pos), PosicionAleatoria());
                return;
            }
 
            if (Recursos.TryGetValue(TipoRecurso.Oro, out int oro) && oro >= 150)
            {
                var taller = Edificios.Values.OfType<Taller>().FirstOrDefault(t => t.EstaConstruido);
 
                Func<Posicion, Tropa> fabricaTropa = random.Next(10) switch
                {
                    0 => pos => new Espadachin(pos),
                    1 => pos => new Ballestero(pos),
                    2 => pos => new Piquero(pos),
                    3 => pos => new Arquero(pos),
                    4 => pos => new Explorador(pos),
                    5 => pos => new Hondero(pos),
                    6 => pos => new Mercenario(pos),
                    7 => pos => new Escudero(pos),
                    8 => pos => new Antorchero(pos),
                    _ => pos => new Portaestandarte(pos),
                };
 
                EntrenarLote(taller, fabricaTropa, PosicionAleatoria());
                return;
            }
 
            var tropaDisponible = Unidades.Values.OfType<Tropa>().FirstOrDefault(t => t.EstaViva);
            if (tropaDisponible != null)
            {
                var objetivo = rival.Edificios.Values.FirstOrDefault(e => !e.EstaDestruido) as IObjetivoAtacable
                            ?? rival.Unidades.Values.FirstOrDefault(u => u.EstaViva);
 
                if (objetivo != null && tropaDisponible.Atacar(objetivo))
                {
                    Eventos.Enqueue(new EventoJuego("Ataque", $"{tropaDisponible.Nombre} (IA) atacó {objetivo}."));
                }
                return;
            }
 
            ConstruirEdificio(pos => new House(pos), PosicionAleatoria());
        }
 
        private Posicion PosicionAleatoria() => new Posicion(random.Next(0, Mapa.Ancho), random.Next(0, Mapa.Alto));
    }
}